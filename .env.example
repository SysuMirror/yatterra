# YatTerra 环境变量示例 — 复制为 .env 后填入真实值
#
#   cp .env.example .env && chmod 600 .env
#
# systemd 通过 EnvironmentFile=<平台根目录>/.env 加载（见 systemd/*.service）。
# 源码里的默认值是**通用占位符**（example.com / /srv/yatterra），不是任何真实
# 部署。下面的注释行给出占位默认值 —— 真实部署必须把用到的值取消注释并改成
# 实际值，否则会读到占位符。
# 本文件**不含任何真实凭证**，可以安全提交到公开仓库。

# ─────────────────────────────────────────────────────────────
# 站点身份（换域名/换机器时改这里）
# ─────────────────────────────────────────────────────────────
#YATTERRA_DOMAIN=example.com           # 公网父域，子域名反代挂在它下面
#YATTERRA_PUBLIC_HOST=example.com      # SSH/Web 公网入口主机名（通常同 DOMAIN）
#YATTERRA_PUBLIC_SCHEME=https
#YATTERRA_ROOT=/srv/yatterra           # 平台根目录（状态文件/配置/日志）
#YATTERRA_WEB_DIR=/srv/yatterra/web
#YATTERRA_PLATFORM_URL=https://example.com:24000   # 平台自身公网 URL

# 公网端口方案：组索引 i → SSH 22000+i，web 23000+i
#YATTERRA_SSH_PUBLIC_BASE=22000
#YATTERRA_WEB_PUBLIC_BASE=23000
#YATTERRA_GUI_PORT=24000
#YATTERRA_SSH_NODEPORT_BASE=31000
#YATTERRA_WEB_NODEPORT_BASE=32000

# ─────────────────────────────────────────────────────────────
# Kubernetes
# ─────────────────────────────────────────────────────────────
#YATTERRA_GROUP_NS=clouds            # 组容器所在命名空间
#YATTERRA_INFRA_NS=platform-infra
#YATTERRA_GROUP_IMAGE=docker.io/sse/cloud-ubuntu:24.04
#YATTERRA_GROUP_CONTAINER=ubuntu
#YATTERRA_CLOUD_USER=cloud           # 容器内非特权登录用户
#YATTERRA_CLOUD_UID=1000
#YATTERRA_PASSWORD_ENV=CLOUD_PASSWORD  # 入口脚本读取的密码环境变量名
# 集群内服务端点（默认由命名空间推导，一般不用改）
#YATTERRA_MYSQL_SERVICE=mysql.platform-infra.svc.cluster.local
#YATTERRA_REDIS_SERVICE=redis.platform-infra.svc.cluster.local
#YATTERRA_QDRANT_SERVICE=qdrant.platform-infra.svc.cluster.local
#YATTERRA_MINIO_SERVICE=minio.platform-infra.svc.cluster.local

# ─────────────────────────────────────────────────────────────
# 宿主机数据目录（hostPath 卷）
# ─────────────────────────────────────────────────────────────
#YATTERRA_GROUP_DATA_ROOT=/srv/data/groups
#YATTERRA_SHARED_ROOT=/srv/data/shared
#YATTERRA_DB_DATA_ROOT=/srv/data/db
#YATTERRA_MINIO_DATA_ROOT=/srv/data/minio
#YATTERRA_HONEYPOT_DIR=/srv/data/honeypot
#YATTERRA_PRESSURE_DIR=/srv/data/shared/pressure
#YATTERRA_DISK_MOUNTS=/,/srv/data

# ─────────────────────────────────────────────────────────────
# 数据库 / 对象存储 [必填]
# ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=
MINIO_ACCESS_KEY=
MINIO_SECRET=
#YATTERRA_MYSQL_HOST=            # 留空则自动发现 mysql Service ClusterIP

# ─────────────────────────────────────────────────────────────
# LLM 提供方
# ─────────────────────────────────────────────────────────────
#LLM_API_KEY=                    # 覆盖 llm_providers.json 里的 api_key
#LLM_MAX_CONCURRENCY=4
#LLM_MAX_RETRIES=4
#EMBEDDING_BASE_URL=https://api.example.com/v1/embeddings
#EMBEDDING_API_KEY=

# ─────────────────────────────────────────────────────────────
# OAuth 登录 [必填]（不设置则对应登录方式不可用）
# ─────────────────────────────────────────────────────────────
SSEMARKET_OAUTH_APP_ID=
SSEMARKET_OAUTH_APP_SECRET=
#SSEMARKET_OAUTH_AUTHORIZE_URL=https://sso.example.com/authorize
#SSEMARKET_OAUTH_TOKEN_URL=https://example.com/api/auth/connect/token
#SSEMARKET_OAUTH_USERINFO_URL=https://example.com/api/auth/connect/userinfo
#SSEMARKET_OAUTH_SCOPE=read_basic

UNISSO_OAUTH_CLIENT_ID=
UNISSO_OAUTH_CLIENT_SECRET=
#UNISSO_OAUTH_AUTHORIZE_URL=https://sso.example.com/authorize
#UNISSO_OAUTH_TOKEN_URL=http://127.0.0.1:32004/api/oauth/token
#UNISSO_OAUTH_USERINFO_URL=http://127.0.0.1:32004/api/oauth/userinfo
#UNISSO_OAUTH_SCOPE=openid profile email
#YATERRA_BASE_URL=https://example.com:14000

# ─────────────────────────────────────────────────────────────
# Webhook 签名 [必填]（deploy 回调鉴权；留空则自动生成到 webhook.conf）
# ─────────────────────────────────────────────────────────────
WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# frp — frpc 管理 API（reload 隧道）[必填]
# ─────────────────────────────────────────────────────────────
#FRPC_ADMIN_URL=http://127.0.0.1:7500
#FRPC_ADMIN_USER=admin
FRPC_ADMIN_PASS=

# ─────────────────────────────────────────────────────────────
# 公网中继服务器（remote_hosts.json 里的条目名 + 远端路径）
# ─────────────────────────────────────────────────────────────
#YATTERRA_RELAY_HOST=relay
#YATTERRA_NGINX_PROXY_CONF=/etc/nginx/conf.d/relay-proxy.conf
#YATTERRA_NGINX_PROXY_CONTAINER=nginx-proxy
#YATTERRA_NGINX_WEB_CONF=/etc/nginx/sites-available/https-web.conf
#YATTERRA_NGINX_SSL_CERT=/etc/nginx/ssl/example.com/fullchain.pem
#YATTERRA_NGINX_SSL_KEY=/etc/nginx/ssl/example.com/privkey.pem
#YATTERRA_RESERVED_SUBDOMAINS=www,cloud,sso,admin

# ─────────────────────────────────────────────────────────────
# 其它
# ─────────────────────────────────────────────────────────────
#YATTERRA_FRPC_FILE=/etc/frp/frpc.toml
#YATTERRA_FLEET_DB=/srv/yatterra/web/fleet_metrics.db
#YATTERRA_FLEET_CONFIG=/srv/yatterra/remote_hosts.json
#YATTERRA_HARNESSES_DIR=/srv/yatterra/harnesses
#YATTERRA_HARNESSES_PUBLIC_DIR=/srv/yatterra/harnesses_public
#YATTERRA_LOCAL_HOST_NAME=node1
#YATTERRA_KB_PREFIX=yatterra_
