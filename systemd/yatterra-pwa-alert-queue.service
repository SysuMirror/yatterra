[Unit]
Description=YatTerra durable PWA webhook notification queue
After=network.target
[Service]
Type=simple
WorkingDirectory=/srv/yatterra/web
ExecStart=/usr/bin/python3 -c 'import pwa_alerts; pwa_alerts.queue_worker()'
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/yatterra/.env
[Install]
WantedBy=multi-user.target
